   "source": [
    "# generator \n",
    "\n",
    "def gen(list, chunk):\n",
    "\n",
    "    for i in range(0, len(list), chunk):\n",
    "        yield list[i:i+chunk]\n",
    "\n",
    "data = gen([2,33,44,55,666,777,888,999,111], 3)\n",
    "\n",
    "print(next(data))\n",
    "print(next(data))\n",
    "print(next(data))\n"
   ]
  }
